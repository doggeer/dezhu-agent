# dezhu-agent 环境变量配置
# 复制此文件为 .env 并填入实际值

# REQUIRED: API 密钥
OPENAI_API_KEY=sk-your-key-here

# OPTIONAL: API 基础地址（默认 https://api.deepseek.com）
# OPENAI_BASE_URL=https://api.deepseek.com

# OPTIONAL: 模型名称（默认 deepseek-flash）
# MODEL_NAME=deepseek-flash

# OPTIONAL: 最大 iteration 次数（默认 90）
# ITERATION_BUDGET=90

# OPTIONAL: API 超时秒数（默认 30）
# API_TIMEOUT=30

# OPTIONAL: 思考模式开关（true/false，默认 false）
# THINKING_ENABLED=false

# OPTIONAL: 思考强度（high/max，默认 high）
# REASONING_EFFORT=high

# OPTIONAL: 流式输出（true/false，默认 false）
# STREAM_MODE=false

# OPTIONAL: Debug 模式 — 输出 system prompt 组装来源到 stderr（1=启用，默认禁用）
# DEZHU_DEBUG=1

# OPTIONAL: 用户项目目录 — 读取 AGENTS.md 的位置（默认当前工作目录）
# DEZHU_PROJECT_DIR=/path/to/your/project

# OPTIONAL: 数据库文件路径（默认 .dezhu-agent/dezhu-agent.db）
# DEZHU_DB_PATH=/path/to/custom.db
